# Frontend
VITE_API_BASE_URL=/api

# MySQL
MYSQL_USER=root
# 数据库口令不提供可用默认值：留空或仍是占位说明时服务拒绝启动，与 SECRET_KEY 同一治理强度
# （backend/config.py 的 ensure_mysql_password_configured，启动时由 backend/main.py 调用）。
# 生成一个随机口令，并把同一口令设到上面这个 MySQL 账号上：
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_PASSWORD=<在 MySQL 上为上面的账号设置一个随机口令，并填在这里>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rag_system
MYSQL_SSL_MODE=
MYSQL_SSL_CA=

# Milvus Lite / local runtime
MILVUS_LITE_URI=./milvus.db
# 向量库地址。默认与 MILVUS_LITE_URI 相同（本地 Milvus Lite 文件）；改用远程 Milvus
# 时填 http://your-milvus-host:19530。请勿留空：留空会覆盖 MILVUS_LITE_URI 回退，
# 运行时拿到空地址。本项不是动态继承，改了 MILVUS_LITE_URI 请同步改这里。
MILVUS_URI=./milvus.db
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
MILVUS_COLLECTION_NAME=
REBUILD_KNOWLEDGE_INDEX_ON_STARTUP=false
CHECKPOINTER_DB_PATH=./checkpointer.db

# Bootstrap accounts. Startup seeding runs only when SEED_DEFAULT_USERS is true.
# Passwords come from the matching variable; when it is empty an unguessable random
# password is generated instead of a known default, so any account you intend to use
# must set its password here. Leading/trailing whitespace is ignored.
# Set SEED_DEFAULT_USERS=false to create no account at all.
SEED_DEFAULT_USERS=true
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Knowledge base upload. Allowed file types: txt, md, docx, pdf.
KNOWLEDGE_UPLOAD_MAX_MB=10

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseekv4flash

# 阿里云百炼 DashScope 公共密钥。VISION_API_KEY / TEXT_FALLBACK_API_KEY /
# EMBEDDING_API_KEY / RERANK_API_KEY 未单独填写时，全部回退到这个值；
# 只填这一个即可让视觉、文本兜底、向量化、重排四路共用同一密钥。留空则四路都没有密钥。
DASHSCOPE_API_KEY=

# Vision / image attachments
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.6-plus
VISION_OSS_URL_EXPIRES_SECONDS=3600

# Text fallback
TEXT_FALLBACK_ENABLED=true
TEXT_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_FALLBACK_API_KEY=
TEXT_FALLBACK_MODEL=qwen3.6-plus

# RAG 分阶段模型覆盖。留空即继承：ROUTER_* 继承 TEXT_FALLBACK_*；
# PLANNER_* / ANSWER_* / MEMORY_* / RERANK_LLM_* / RAGAS_* 继承 DEEPSEEK_*。
# 只填某个阶段的 API_KEY 时，该阶段的 BASE_URL 与 MODEL 仍沿用对应的继承来源。
# RAGAS 的模型继续使用下方原有的 RAGAS_LLM_MODEL，这里只需覆盖地址与密钥。
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
ANSWER_BASE_URL=
ANSWER_API_KEY=
ANSWER_MODEL=
MEMORY_BASE_URL=
MEMORY_API_KEY=
MEMORY_MODEL=
RERANK_LLM_BASE_URL=
RERANK_LLM_API_KEY=
RERANK_LLM_MODEL=
RAGAS_BASE_URL=
RAGAS_API_KEY=

# Embedding
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# 单次向量化请求超时（秒）。检索一轮最多发起 9 次，默认压到在线问答量级，
# 避免一次慢请求拖住整轮。批量入库另用下面的 EMBEDDING_INGEST_TIMEOUT_SECONDS。
EMBEDDING_TIMEOUT_SECONDS=10
# 向量化模型能力上限（DashScope text-embedding-v4：单批最多 10 条，单条最多 8192 tokens）。
# 入库按「条数上限 + token 预算」双约束打包；token 由 tiktoken 的 cl100k_base 本地确定性
# 估算（不拿字符数冒充 token）。单条上限直接取 EMBEDDING_MAX_REQUEST_TOKENS；安全系数只
# 用于合批预算（EMBEDDING_MAX_REQUEST_TOKENS × EMBEDDING_TOKEN_SAFETY_RATIO），取值越界
# 会被夹到 (0, 1] 并打 warning。
EMBEDDING_MAX_BATCH_ITEMS=10
EMBEDDING_MAX_REQUEST_TOKENS=8192
EMBEDDING_TOKEN_SAFETY_RATIO=0.85  # scan-secrets:allow numeric ratio, not a credential
# tiktoken 的 BPE 缓存目录（cl100k_base）。留空时使用 tiktoken 默认的临时目录。离线或
# 受限网络部署必须指向已预置 cl100k_base.tiktoken 的目录，否则首次入库会因无法下载
# 分词表而失败；启动日志会打印实际生效的缓存目录与预置文件名。
TIKTOKEN_CACHE_DIR=
# 429/5xx 的最多重试次数（不含首次请求），按指数退避并尊重 Retry-After，但单次退避
# 不超过 30 秒、也不超过整份文档的剩余预算；400 等永久错误不重试。
EMBEDDING_MAX_RETRIES=2
# 兼容旧配置：条数上限取两者较小值（旧值只能收紧，不能突破模型上限）；
# 字符上限是额外的旧约束，0 表示关闭。新部署请只调上面的模型能力参数。
EMBEDDING_INGEST_BATCH_SIZE=10
EMBEDDING_INGEST_BATCH_MAX_CHARS=0
# 入库单批向量化超时（秒）。单批最多 10 条，比旧版 64 条小得多；
# 且入库已在线程池上执行，慢请求不占事件循环，故仍给到检索预算（10 秒）的 6 倍。
EMBEDDING_INGEST_TIMEOUT_SECONDS=60
# 入库专用线程池的线程数。检索与入库分开用池：两者共用 asyncio 默认 executor 时，
# 并发上传把池占满会让整轮多路检索排在入库之后。这个值同时限制并发上传数，
# 也就是同时占用向量化连接的请求数，不宜调大。
KNOWLEDGE_INDEX_MAX_WORKERS=4
# 单份文档的入库总时限（秒），从解析开始计，解析/分块/向量化共享这一个预算。
# EMBEDDING_INGEST_TIMEOUT_SECONDS 只约束单批外呼；一份文档要发多批，
# 没有总量约束时一次上传可以无限期占住一个入库线程。
KNOWLEDGE_INDEX_TOTAL_TIMEOUT_SECONDS=300
# 切片 token 预算（issue #287）。入库默认按 token 而不是固定字符窗口切片：
# 硬上限 500、目标 400、重叠 50，均由 tiktoken 的 cl100k_base 计数（中文约 1.1 token/字，
# 不是拿字符数冒充 token）。安全系数把硬上限缩为实际预算 500 × 0.85 = 425，给上游
# 分词器留余量；目标值会被夹到实际预算以内。显式传 chunk_size/chunk_overlap 的调用
# 仍走字符路径，不受这几项影响。
CHUNK_TOKEN_LIMIT=500
CHUNK_TOKEN_TARGET=400
CHUNK_TOKEN_OVERLAP=50
CHUNK_TOKENIZER=cl100k_base  # scan-secrets:allow tokenizer encoding name, not a credential
CHUNK_TOKEN_SAFETY_RATIO=0.85  # scan-secrets:allow numeric ratio, not a credential
# 父子切片（issue #289）。默认关闭：child 带确定性章节前缀入库并参与召回，命中后按
# parent_id 聚合为 parent 内容；关闭后上传与检索都完全回到 #287 的单层切片行为。
# 开启条件：issue #293 目前只有 phase-1 dry-run（指标为 not_run），尚无「单层 vs 父子」
# 的真实 Recall@5 / 引用命中对比。等 phase 2 接入真实检索、指标不劣于单层后再开启。
# 注意：存量单层数据需要设置 REBUILD_KNOWLEDGE_INDEX_ON_STARTUP=true 或在关闭期后手动
# 重建索引，否则旧文件仍是单层粒度（检索时按 child 内容降级），新旧粒度会混用。
PARENT_CHILD_ENABLED=false
# 聚合后的父级上下文总 token 绝对上限。rerank 最多返回 5 个槽位，每个 parent 可能由多个
# child 聚合而成；超限时按 parent 边界从尾部整块丢弃，不把 parent 截成半条（半条会丢掉
# 但书/例外），trace.parent_child 记录 expanded_tokens 与 truncated。
PARENT_CONTEXT_MAX_TOKENS=6000

# Rerank
RERANK_PROVIDER=dashscope
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=30
RERANK_LLM_FALLBACK_ENABLED=true

# RAGAS is optional. Install backend/requirements-ragas.txt before enabling it.
RAGAS_ENABLED=false
RAGAS_LLM_MODEL=deepseekv4flash
RAGAS_TIMEOUT_SECONDS=180
RAGAS_METRIC_TIMEOUT_SECONDS=60
RAGAS_MAX_CONTEXTS=3
RAGAS_MAX_CONTEXT_CHARS=1500
RAGAS_MAX_ANSWER_CHARS=2000

# Retrieval
RETRIEVAL_ROUTE_TOP_K=8
RETRIEVAL_RERANK_TOP_N=5
# BM25 关键词排序（issue #288）。开启后关键词路由按 BM25 排序，关闭则保持旧命中打分排序。
# DF 语料是知识库全部关键词窗口（与召回同一套 KEYWORD_CHUNK_SIZE=900 窗口），不是本次
# LIKE 候选集。成本边界（均为实测，见 PR #301 修订报告）：
#
# * BM25_MAX_DOCS：可索引窗口数上限。窗口步长 = 900 - 180 = 720，20000 个窗口覆盖约
#   14.4M 个不重复字符（(20000-1)×720+900）。超限降级回旧排序，状态与原因写入
#   retrieval_trace.bm25，并打 operator 可见 warning。
# * BM25_MAX_TERMS：distinct 词表上限。CPython 3.10 实测 DF Counter 约 126 字节/词条
#   （2000 窗口 × 450 随机汉字 → 877k 词条 → 105MB），200000 词条约 25MB。超限同样永久降级
#   并 warning。上传上限 KNOWLEDGE_UPLOAD_MAX_MB=10 只约束原始字节，正文是 LONGTEXT，所以
#   真正兜住内存的是这两个上限，而不是上传体积。
# * BM25_MAX_SCORED_CANDIDATES：每次提问最多对多少个 LIKE 命中窗口做完整 BM25 打分（每个
#   窗口要重新 tokenize 一次 900 字文本）。扫描时先用「命中词项 IDF 之和」这个廉价代理
#   预排序（忽略词频与长度归一化，只是预排序信号，不是真实分数的严格上界）。触顶时
#   scoring_budget_exceeded=true，预算外窗口会被截断、不再参与打分，最终 top-k 是近似
#   排序；该字段只说明截断发生，不能理解为「没有丢候选」。
#
# 预热：进程启动、知识上传成功、知识删除成功后都会在后台线程重建对应知识库的语料（单飞，
# 同一知识库只建一次），第一问因此不必自己承担整库扫描；后台预热失败不影响请求路径，下一问
# 会自行构建。缓存按 (数据库, 知识库, k1, b, max_docs, max_terms) 做键，最多保留 8 个知识库；
# 活跃知识库超过 8 个时，最冷的一个下次提问会重建一次（一次性全库扫描）。
BM25_ENABLED=true
BM25_K1=1.5
BM25_B=0.75
BM25_MAX_DOCS=20000
BM25_MAX_TERMS=200000
BM25_MAX_SCORED_CANDIDATES=512

# 多轮对话记忆：保留的最近对话轮数。
# TOKENS 是模型生成预算（实际生效的压缩上限），CHARS 只是写入数据库的存储上限。
MEMORY_WINDOW_TURNS=4
MEMORY_SUMMARY_MAX_TOKENS=900
MEMORY_RECENT_MAX_TOKENS=900
MEMORY_SUMMARY_MAX_CHARS=15000
MEMORY_RECENT_MAX_CHARS=8000

# 学习轨迹（调试用）：是否记录轨迹、单条轨迹文本的截断长度（单位：字符）。
LEARNING_TRACE_ENABLED=true
LEARNING_TRACE_MAX_TEXT_CHARS=1200

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# Chat attachment reclamation. Uploads register a pending row; a successful send consumes it
# in the same transaction as the message. Rows still unconsumed after this window have their
# object deleted by the sweep. Keep it well above the longest plausible "picked an image,
# will send it in a moment" pause: deleting early destroys an object a live message needs.
CHAT_ATTACHMENT_PENDING_TTL_SECONDS=86400
# Objects one sweep run may process; the rest wait for the next run.
CHAT_ATTACHMENT_SWEEP_BATCH_LIMIT=200
# Seconds between sweep rounds (the first round runs at startup).
CHAT_ATTACHMENT_SWEEP_INTERVAL_SECONDS=21600
# How long a sweep may hold a row before another sweep round may retry it. The sweep commits
# the deletion intent before calling the object store; if the process dies mid-call, the row
# stays claimed until this lease expires, after which a later round retries the delete. Keep it
# comfortably above one DELETE round trip.
CHAT_ATTACHMENT_LEASE_SECONDS=300
# How long a committed deletion intent (tombstone) is kept before the sweep garbage-collects
# it. The tombstone is what makes the send path refuse a key whose object is being deleted, so
# this must stay well above the longest plausible delay between "user picked an image" and the
# send that references it. 0 disables the GC: tombstones then live forever.
CHAT_ATTACHMENT_TOMBSTONE_TTL_SECONDS=604800

# 请求限流（issue #183）。阈值给了安全默认值，按部署规模调整。
# 登录节流按「账号 + 来源地址」计数：同一账号在该窗口内的失败达到上限后，登录接口返回
# 429 + Retry-After，窗口滑出即自动恢复（不做永久锁定）。阈值内的正确口令不受影响。
# 账号按「去空白 + 去大小写 + 去重音」折叠后归桶（与库侧 utf8mb4_unicode_ci 对齐），
# 所以 café 与 cafe 记在同一桶里，不会各开一份预算；写法上分不出区别的账号共用一把锁。
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# 单个进程内同时在跑的 SSE 聊天流上限。超出的请求立刻 429（不排队等上游超时），槽位在
# 流正常结束、流内抛异常、客户端断开三条路径上释放。多 worker / 多实例部署时每个进程
# 各持一份计数，真实上限 = 这个值 × 进程数；需要跨进程一致的上限请换共享计数器。
CHAT_STREAM_MAX_CONCURRENCY=8

# JWT. SECRET_KEY is read from the environment (or this .env) with surrounding whitespace
# trimmed and used verbatim otherwise. The placeholder below is
# public: leaving SECRET_KEY empty or keeping this value makes the service refuse to start,
# because anyone with a copy of this repository could otherwise sign a token for any user,
# including admin. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local development only. Allows startup without SECRET_KEY by generating a random per-process
# key; every restart invalidates all issued tokens, and multi-worker setups will disagree on
# tokens. Never enable it for a deployment reachable by others.
ALLOW_INSECURE_DEFAULT_SECRET=false

# Local development only. Allows startup while MYSQL_PASSWORD is still the public placeholder,
# and logs a warning saying so. It is independent of ALLOW_INSECURE_DEFAULT_SECRET - enabling
# either one never relaxes the other's check. Never enable it for a deployment reachable by
# others.
ALLOW_INSECURE_DEFAULT_MYSQL_PASSWORD=false
